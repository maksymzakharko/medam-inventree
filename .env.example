# Szablon etapu 1 — nie jest działającą konfiguracją produkcyjną.
# Sekrety zostaną dostarczone jako pliki poza Git; żadnych wartości w tym pliku.
NODE_ENV=production
APP_ORIGIN=https://magazyn.example.invalid
APP_TIMEZONE=Europe/Warsaw
API_HOST=0.0.0.0
API_PORT=3000
APP_DATABASE_URL_FILE=/run/secrets/app_database_url
SESSION_SECRET_FILE=/run/secrets/session_secret
INVENTREE_URL=http://inventree-server:8000
INVENTREE_TOKEN_FILE=/run/secrets/inventree_api_token
INVENTREE_EXPECTED_VERSION=1.7.0
INVENTREE_EXPECTED_API_VERSION=570
INVENTREE_TIMEOUT_MS=10000
BACKUP_REPOSITORY=
BACKUP_PASSWORD_FILE=/run/secrets/backup_password
ALERT_WEBHOOK_FILE=/run/secrets/alert_webhook
