# infrastructure/scripts/setup.sh generates .env and random secrets.
COMPOSE_PROJECT_NAME=medam
MEDAM_MODE=local
APP_ORIGIN=http://localhost:8080
APP_DOMAIN=magazyn.example.invalid
APP_HTTP_PORT=8080
ADMIN_HTTP_PORT=8090
INVENTREE_SITE_URL=http://localhost:8090
MEDAM_INGRESS_SUBNET=172.30.10.0/28
API_IMAGE=medam-api:local
EDGE_IMAGE=medam-edge:local
# Empty or unset uses the pinned image in Compose.
# INVENTREE_IMAGE=inventree/inventree:1.7.0@sha256:2459dea3237b5d55898258539b39d16ca6a5fd76949d0d749b42cdd2fee16941
# One secret directory per instance; keep outside Git and protect with 0700/0600.
SECRETS_DIR=./secrets
BACKUP_ROOT=./backups
# Configure on host in a private restic.env: RESTIC_REPOSITORY, RESTIC_PASSWORD_FILE,
# backend credentials and optional ALERT_WEBHOOK_FILE. Never commit that file.
# MONITOR_HTTPS_ORIGIN=https://your-domain belongs in /etc/medam/monitor.env.
