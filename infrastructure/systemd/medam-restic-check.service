[Unit]
Description=MEDAM daily offsite repository metadata integrity check
After=network-online.target
Wants=network-online.target
OnFailure=medam-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/medam
EnvironmentFile=/etc/medam/restic.env
Environment=RESTIC_CACHE_DIR=/var/cache/medam-restic
CacheDirectory=medam-restic
CacheDirectoryMode=0700
ExecStart=/opt/medam/infrastructure/scripts/restic-check.sh --metadata
TimeoutStartSec=2h
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
