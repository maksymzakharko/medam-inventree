[Unit]
Description=MEDAM read-only host, containers and inventory consistency monitoring
After=docker.service network-online.target
OnFailure=medam-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/medam
EnvironmentFile=-/etc/medam/restic.env
EnvironmentFile=-/etc/medam/monitor.env
Environment=MONITOR_STATE_DIR=/var/lib/medam-monitor
StateDirectory=medam-monitor
StateDirectoryMode=0700
ExecStart=/opt/medam/infrastructure/scripts/monitor.sh
TimeoutStartSec=4min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
